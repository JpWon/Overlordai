{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "overlordai\\.vercel\\.app"
        }
      ],
      "destination": "https://www.overlordai.co/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "overlordai\\.vercel\\.app"
        }
      ],
      "destination": "https://www.overlordai.co/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/featured",
      "destination": "/featured.html"
    },
    {
      "source": "/plans",
      "destination": "/plans.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout.html"
    },
    {
      "source": "/thanks",
      "destination": "/thanks.html"
    },
    {
      "source": "/thank-you",
      "destination": "/thanks.html"
    },
    {
      "source": "/refunds",
      "destination": "/refunds.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/eula",
      "destination": "/eula.html"
    }
  ]
}
