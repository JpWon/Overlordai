# Resend (email sending) — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# "From" address. Must be a domain you verified in Resend, or the test sender:
RESEND_FROM=Overlord AI <waitlist@overlordai.co>
# Where the signup email lands:
WAITLIST_TO=info@overlordai.co

# Supabase (data table) — project URL + anon key (Dashboard → Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Table + column the signup is written to (defaults shown)
WAITLIST_TABLE=waitlist
WAITLIST_EMAIL_COLUMN=email
